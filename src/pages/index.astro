---
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim();
if (formspreeEndpoint && !/^https:\/\/formspree\.io\/f\/[A-Za-z0-9]+$/.test(formspreeEndpoint)) {
	throw new Error('PUBLIC_FORMSPREE_ENDPOINT debe ser una URL válida de formulario de Formspree.');
}

const projects = [
	{
		type: 'PLATAFORMA WEB',
		name: 'Dávila Tours',
		client: 'Dávila Tours',
		image: '/images/solutions/davila-tours-web.png',
		alt: 'Plataforma web de Dávila Tours en una pantalla de escritorio',
		className: 'project-web',
		repository: 'https://github.com/ISandBi/davila-tours',
	},
	{
		type: 'APLICACIÓN MÓVIL',
		name: 'Kinder Nahla',
		client: 'Kinder Nahla S.A.',
		image: '/images/solutions/kinder-nahla-mobile.png',
		alt: 'Pantalla móvil de la aplicación de Kinder Nahla',
		className: 'project-kinder',
		repository: 'https://github.com/ISandBi/Aplicaci-n-Educativa-para-Kinder',
	},
	{
		type: 'APLICACIÓN MÓVIL',
		name: 'Gavaldoon Go!',
		client: 'Gavaldoon Go!',
		image: '/images/solutions/gavaldoon-go-mobile.png',
		alt: 'Aplicación móvil Gavaldoon Go! con mapa y estaciones de servicio',
		className: 'project-gavaldoon',
		repository: 'https://github.com/ISandBi/gavaldon-app',
	},
];

const solutions = [
	{
		name: 'Dávila Tours',
		monogram: 'DT',
		category: 'web',
		categoryLabel: 'Plataforma web',
		technology: 'Python · Flask',
		description: 'Reservas de viajes, seguimiento de apartados y gestión de flota en una sola plataforma.',
		repository: 'https://github.com/ISandBi/davila-tours',
	},
	{
		name: 'OrderSync Ecommerce',
		monogram: 'OS',
		category: 'web',
		categoryLabel: 'Comercio digital',
		technology: 'E-commerce',
		description: 'Proyecto de comercio electrónico organizado con una arquitectura multicapa.',
		repository: 'https://github.com/ISandBi/ordersync-ecommerce',
	},
	{
		name: 'DeskFlex México',
		monogram: 'DF',
		category: 'ops',
		categoryLabel: 'Operaciones',
		technology: 'Python · Flask',
		description: 'Reservas de espacios de coworking, control de acceso, QR y check-in.',
		repository: 'https://github.com/ISandBi/deskflex-web',
	},
	{
		name: 'Gavaldon GO!',
		monogram: 'GG',
		category: 'apps',
		categoryLabel: 'Aplicación móvil',
		technology: 'Android · Kotlin',
		description: 'App móvil con estaciones, precios, compras de combustible e historial.',
		repository: 'https://github.com/ISandBi/gavaldon-app',
	},
	{
		name: 'NovaTech Landing',
		monogram: 'NT',
		category: 'web',
		categoryLabel: 'Sitio web',
		technology: 'Landing page',
		description: 'Sitio de presentación de marca y propuesta digital.',
		repository: 'https://github.com/ISandBi/novatech-landing',
	},
	{
		name: 'StockTrack Inventory',
		monogram: 'ST',
		category: 'ops',
		categoryLabel: 'Operaciones',
		technology: 'Gestión de inventario',
		description: 'Proyecto orientado al control de inventario con arquitectura monolítica.',
		repository: 'https://github.com/ISandBi/stocktrack-inventory',
	},
	{
		name: 'GrooveSpace',
		monogram: 'GS',
		category: 'web',
		categoryLabel: 'Plataforma digital',
		technology: 'JavaScript',
		description: 'Proyecto web desarrollado con JavaScript; explora sus módulos directamente en GitHub.',
		repository: 'https://github.com/ISandBi/groovespace',
	},
	{
		name: 'IS&BI Solutions',
		monogram: 'IS',
		category: 'web',
		categoryLabel: 'Sitio corporativo',
		technology: 'Astro',
		description: 'Nuestro espacio para presentar servicios, proyectos y soluciones digitales.',
		repository: 'https://github.com/ISandBi/web-isandbi',
	},
	{
		name: 'Aplicación Educativa para Kinder',
		monogram: 'KN',
		category: 'apps',
		categoryLabel: 'Educación',
		technology: 'Aplicación educativa',
		description: 'Proyecto de aplicación educativa dirigido a nivel preescolar.',
		repository: 'https://github.com/ISandBi/Aplicaci-n-Educativa-para-Kinder',
	},
];
---

<Layout title="IS&BI Solutions | Software hecho para avanzar">
	<header class="site-header">
		<div class="header-inner">
			<a class="brand" href="#inicio" aria-label="IS&BI Solutions, inicio">
				<span class="brand-mark" aria-hidden="true">IS</span>
				<span class="brand-name">IS&BI <span>SOLUTIONS</span></span>
			</a>
			<nav class="main-nav" aria-label="Navegación principal">
				<a href="#soluciones">Soluciones</a>
				<a href="#proyectos">Portafolio</a>
				<a href="#explorar">Explorar</a>
				<a href="#nosotros">Nosotros</a>
				<a href="#contacto">Contacto</a>
			</nav>
			<a class="header-link" href="#contacto">Conversemos <span aria-hidden="true">↗</span></a>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
			<div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
			<div class="hero-inner section-wrap">
				<div class="hero-copy" data-reveal>
					<p class="eyebrow"><span class="eyebrow-line"></span> TECNOLOGÍA CON VISIÓN DE NEGOCIO</p>
					<h1>Ideas ambiciosas.<br /><span>Software que las mueve.</span></h1>
					<p class="hero-description">
						Desarrollamos productos digitales a la medida y nos involucramos de verdad en cada
						proyecto, desde la primera conversación.
					</p>
					<a class="button button-hero" href="#contacto">
						Cuéntame qué tienes en mente <span class="button-arrow" aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="hero-visual" aria-label="Nuestro equipo y sus espacios de trabajo" data-reveal>
					<div class="hero-photo hero-photo-main">
						<img src="/images/instalaciones.jpeg" alt="Instalaciones de IS&BI Solutions" fetchpriority="high" />
					</div>
					<div class="hero-photo hero-photo-secondary">
						<img src="/images/equipo-consultoria.jpg" alt="Equipo de IS&BI Solutions trabajando en una sesión" />
					</div>
					<div class="hero-note">
						<span class="hero-note-mark" aria-hidden="true">↗</span>
						<p>Un equipo cerca.<br /><strong>En cada etapa.</strong></p>
					</div>
					<span class="hero-caption">MÉXICO · EQUIPO IS&BI</span>
				</div>
			</div>
			<a class="scroll-cue" href="#soluciones"><span aria-hidden="true"></span> Desliza para descubrir</a>
		</section>

		<section class="intro-strip" aria-label="Nuestro enfoque">
			<div class="section-wrap intro-strip-inner">
				<p>ESTRATEGIA, DISEÑO Y TECNOLOGÍA</p>
				<span>De la idea al siguiente paso.</span>
			</div>
		</section>

		<section class="solutions-intro section-wrap" id="soluciones" data-reveal>
			<div>
				<p class="eyebrow"><span class="eyebrow-line"></span> LO QUE HACEMOS</p>
				<h2>La solución correcta<br /><span>cambia el panorama.</span></h2>
			</div>
			<p>
				Creamos herramientas digitales para resolver problemas reales, servir mejor a tus clientes
				y darle espacio a tu negocio para crecer.
			</p>
		</section>

		<section class="solution solution-web" aria-labelledby="web-title" data-reveal>
			<div class="section-wrap solution-layout">
				<div class="solution-copy">
					<p class="solution-kicker">01 <span>·</span> APLICACIONES WEB</p>
					<h2 id="web-title">Una mejor experiencia, <em>en cada pantalla.</em></h2>
					<p>
						Plataformas y sitios que ordenan procesos complejos y hacen más fácil cada interacción
						con tu negocio.
					</p>
					<ul class="solution-points">
						<li>Diseño pensado para las personas</li>
						<li>Rendimiento preparado para crecer</li>
						<li>Integración con tus procesos actuales</li>
					</ul>
					<a class="text-link" href="#contacto">Hablemos de tu solución <span aria-hidden="true">↗</span></a>
				</div>
				<figure class="solution-visual web-visual">
					<div class="image-wash" aria-hidden="true"></div>
					<img
						src="/images/solutions/davila-tours-web.png"
						alt="Vista de la plataforma web de Dávila Tours en escritorio"
						loading="lazy"
					/>
					<figcaption>PLATAFORMA WEB · DÁVILA TOURS</figcaption>
				</figure>
			</div>
		</section>

		<section class="solution solution-mobile" aria-labelledby="mobile-title" data-reveal>
			<div class="section-wrap solution-layout">
				<div class="solution-copy">
					<p class="solution-kicker">02 <span>·</span> APLICACIONES MÓVILES</p>
					<h2 id="mobile-title">Tu servicio, <em>siempre a la mano.</em></h2>
					<p>
						Experiencias móviles intuitivas que acercan tus servicios a las personas y hacen que
						cada paso se sienta natural.
					</p>
					<ul class="solution-points">
						<li>Interacciones claras y accesibles</li>
						<li>Diseñadas para el uso cotidiano</li>
						<li>Preparadas para iOS y Android</li>
					</ul>
					<a class="text-link" href="#contacto">Imaginemos tu app <span aria-hidden="true">↗</span></a>
				</div>
				<div class="mobile-showcase" aria-label="Ejemplos de aplicaciones móviles" data-reveal>
					<div class="mobile-image mobile-image-kinder">
						<img
							src="/images/solutions/kinder-nahla-mobile.png"
							alt="Aplicación móvil de Kinder Nahla"
							loading="lazy"
						/>
					</div>
					<div class="mobile-image mobile-image-gavaldoon">
						<img
							src="/images/solutions/gavaldoon-go-mobile.png"
							alt="Aplicación móvil Gavaldoon Go!"
							loading="lazy"
						/>
					</div>
					<span class="mobile-showcase-label">HECHAS PARA USARSE, NO SOLO PARA VERSE</span>
				</div>
			</div>
		</section>

		<section class="solution solution-scale" aria-labelledby="scale-title" data-reveal>
			<div class="section-wrap solution-layout">
				<div class="solution-copy">
					<p class="solution-kicker">03 <span>·</span> ESCALAMIENTO DIGITAL</p>
					<h2 id="scale-title">Crece sin que la tecnología <em>te frene.</em></h2>
					<p>
						Modernizamos tus sistemas y los preparamos para acompañar nuevas oportunidades,
						más clientes y nuevos retos.
					</p>
					<ul class="solution-points">
						<li>Evolución de sistemas existentes</li>
						<li>Infraestructura lista para crecer</li>
						<li>Decisiones guiadas por tus objetivos</li>
					</ul>
					<a class="text-link" href="#contacto">Hablemos de crecimiento <span aria-hidden="true">↗</span></a>
				</div>
				<div class="abstract-visual scale-visual" aria-hidden="true" data-reveal>
					<span class="scale-ring scale-ring-one"></span>
					<span class="scale-ring scale-ring-two"></span>
					<img src="/images/solutions/scale.svg" alt="" loading="lazy" />
					<span class="visual-caption">CONSTRUIDO PARA LO QUE SIGUE</span>
				</div>
			</div>
		</section>

		<section class="solution solution-ai" aria-labelledby="ai-title" data-reveal>
			<div class="section-wrap solution-layout">
				<div class="solution-copy">
					<p class="solution-kicker">04 <span>·</span> INTELIGENCIA ARTIFICIAL</p>
					<h2 id="ai-title">Menos tareas repetidas.<br /><em>Más tiempo para avanzar.</em></h2>
					<p>
						Aplicamos inteligencia artificial donde realmente aporta: para agilizar operaciones,
						encontrar patrones y ayudar a tu equipo a enfocarse en lo importante.
					</p>
					<ul class="solution-points">
						<li>Automatización con propósito</li>
						<li>Herramientas conectadas a tu operación</li>
						<li>Personas al centro de cada decisión</li>
					</ul>
					<a class="text-link" href="#contacto">Explora posibilidades <span aria-hidden="true">↗</span></a>
				</div>
				<div class="abstract-visual ai-visual" aria-hidden="true" data-reveal>
					<span class="ai-orbit ai-orbit-one"></span>
					<span class="ai-orbit ai-orbit-two"></span>
					<img src="/images/solutions/ai.svg" alt="" loading="lazy" />
					<span class="visual-caption">IA APLICADA A RETOS REALES</span>
				</div>
			</div>
		</section>

		<section class="projects section-spacing" id="proyectos" data-reveal>
			<div class="section-wrap">
				<div class="section-heading">
					<div>
						<p class="eyebrow"><span class="eyebrow-line"></span> TRABAJO QUE YA ESTÁ EN MARCHA</p>
						<h2>Proyectos con nombre<br /><span>y propósito.</span></h2>
					</div>
					<p>
						Una selección de productos creados para necesidades reales. Explora el código y
						conoce el propósito detrás de cada proyecto.
					</p>
				</div>

				<div class="project-list">
					{projects.map((project, index) => (
						<article class:list={['project-row', project.className]} data-reveal>
							<div class="project-image">
								<img src={project.image} alt={project.alt} loading="lazy" />
							</div>
							<div class="project-copy">
								<p class="project-type">{project.type}</p>
								<p class="project-index">0{index + 1}</p>
								<h3>{project.name}</h3>
								<div class="project-meta">
									<p><span>CLIENTE</span>{project.client}</p>
									<p><span>ESPECIALIDAD</span>{project.type}</p>
								</div>
								<a class="project-repository" href={project.repository} target="_blank" rel="noopener noreferrer">
									Ver proyecto en GitHub <span aria-hidden="true">↗</span>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="solution-explorer section-spacing" id="explorar" aria-labelledby="explorer-title">
			<div class="section-wrap">
				<div class="section-heading explorer-heading">
					<div>
						<p class="eyebrow"><span class="eyebrow-line"></span> EXPLORADOR DE SOLUCIONES</p>
						<h2 id="explorer-title">Todo lo que estamos<br /><span>construyendo.</span></h2>
					</div>
					<p>
						Explora los repositorios públicos de IS&BI. Filtra por especialidad o busca una
						solución para conocer su código y evolución.
					</p>
				</div>

				<div class="explorer-controls">
					<label class="explorer-search">
						<span class="visually-hidden">Buscar proyectos</span>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="10.8" cy="10.8" r="6.8"></circle>
							<path d="m16 16 4.5 4.5"></path>
						</svg>
						<input type="search" placeholder="Buscar por proyecto o tecnología" data-solution-search />
					</label>
					<div class="explorer-filters" role="group" aria-label="Filtrar proyectos por especialidad">
						<button type="button" class="filter-chip is-active" data-category-filter="all" aria-pressed="true">Todos</button>
						<button type="button" class="filter-chip" data-category-filter="web" aria-pressed="false">Web</button>
						<button type="button" class="filter-chip" data-category-filter="apps" aria-pressed="false">Aplicaciones</button>
						<button type="button" class="filter-chip" data-category-filter="ops" aria-pressed="false">Operaciones</button>
					</div>
				</div>

				<p class="explorer-count" aria-live="polite">
					<span data-solution-count>{solutions.length}</span>
					{' '}<span data-solution-label>proyectos</span>{' '}
					<span data-solution-descriptor>públicos</span>
				</p>

				<div class="solution-grid" data-solution-grid>
					{solutions.map((solution, index) => (
						<article
							class="solution-card"
							data-solution-card
							data-category={solution.category}
							data-search={`${solution.name} ${solution.description} ${solution.categoryLabel} ${solution.technology}`}
							data-reveal
						>
							<div class="solution-card-top">
								<span class="solution-monogram" aria-hidden="true">{solution.monogram}</span>
								<span class="solution-card-index">{String(index + 1).padStart(2, '0')}</span>
							</div>
							<p class="solution-card-category">{solution.categoryLabel}</p>
							<h3>{solution.name}</h3>
							<p class="solution-card-description">{solution.description}</p>
							<div class="solution-card-footer">
								<span class="solution-technology">{solution.technology}</span>
								<a href={solution.repository} target="_blank" rel="noopener noreferrer">
									Explorar <span aria-hidden="true">↗</span>
								</a>
							</div>
						</article>
					))}
				</div>
				<p class="explorer-empty" data-solution-empty hidden>No encontramos proyectos con esa búsqueda.</p>
			</div>
		</section>

		<section class="approach" id="nosotros" data-reveal>
			<div class="section-wrap approach-inner">
				<div class="approach-copy">
					<p class="eyebrow"><span class="eyebrow-line"></span> UNA COLABORACIÓN DIFERENTE</p>
					<h2>No eres un ticket.<br /><span>Eres nuestro socio.</span></h2>
					<p>
						Creemos que los mejores resultados empiezan escuchando. Trabajamos contigo de forma
						cercana, explicamos cada decisión sin rodeos y nos reunimos presencialmente cuando
						el proyecto lo necesita.
					</p>
					<a class="button button-team" href="#contacto">
						Conoce al equipo <span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="approach-points">
					<div class="approach-point">
						<span class="point-number">01</span>
						<div><h3>Escuchamos antes de proponer</h3><p>Entendemos tus metas, tus procesos y el reto detrás de cada idea.</p></div>
					</div>
					<div class="approach-point">
						<span class="point-number">02</span>
						<div><h3>Hablamos en claro</h3><p>Avances visibles, acuerdos transparentes y comunicación directa contigo.</p></div>
					</div>
					<div class="approach-point">
						<span class="point-number">03</span>
						<div><h3>Nos sentamos contigo</h3><p>Juntas presenciales y sesiones de trabajo personalizadas, según lo que necesites.</p></div>
					</div>
				</div>
			</div>
		</section>

		<section class="mission-vision section-wrap section-spacing" id="mision-vision" data-reveal>
			<div class="mission-vision-heading">
				<p class="eyebrow"><span class="eyebrow-line"></span> NUESTRO PROPÓSITO</p>
				<h2>Innovación con <span>dirección.</span></h2>
			</div>
			<div class="mission-vision-grid">
				<article class="mission-vision-item" data-reveal>
					<span>MISIÓN</span>
					<h3>Hacer que la tecnología trabaje para las personas.</h3>
					<p>
						Acompañar a las organizaciones en su transformación digital con soluciones de software
						a la medida que resuelvan necesidades reales y generen valor sostenible.
					</p>
				</article>
				<article class="mission-vision-item" data-reveal>
					<span>VISIÓN</span>
					<h3>Ser el aliado que convierte ideas en posibilidades.</h3>
					<p>
						Ser un aliado tecnológico de confianza, reconocido por acercar la innovación a más
						empresas y crear soluciones digitales útiles, escalables y humanas.
					</p>
				</article>
			</div>
		</section>

		<section class="contact-section" id="contacto" data-reveal>
			<div class="section-wrap contact-layout">
				<div class="contact-copy">
					<p class="eyebrow"><span class="eyebrow-line"></span> EL PRIMER PASO</p>
					<h2>¿Qué te gustaría<br /><span>hacer posible?</span></h2>
					<p>
						Cuéntanos un poco de tu proyecto y déjanos un correo para responderte. Elige tu
						proveedor y nosotros nos encargamos del resto.
					</p>
					<p class="contact-promise">Atención directa, ideas claras y personas reales.</p>
				</div>

				<form
					class="contact-form"
					action={formspreeEndpoint || undefined}
					method="POST"
					data-contact-form
					data-endpoint-ready={formspreeEndpoint ? 'true' : 'false'}
				>
					<h3>Cuéntanos tu idea</h3>
					<label>Nombre completo *
						<input type="text" name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required />
					</label>
					<label>Tu correo *
						<span class="email-combo">
							<input
								type="text"
								name="email-local"
								autocomplete="username"
								inputmode="email"
								placeholder="tu correo"
								pattern="[A-Za-z0-9._%+-]+"
								aria-label="Nombre de usuario del correo"
								required
							/>
							<span class="email-at" aria-hidden="true">@</span>
							<select name="email-domain" aria-label="Proveedor del correo" required>
								<option value="gmail.com">@gmail.com</option>
								<option value="hotmail.com">@hotmail.com</option>
							</select>
						</span>
						<input type="hidden" name="email" data-complete-email />
					</label>
					<label>¿En qué podemos ayudarte? *
						<select name="service" required>
							<option value="" disabled selected>Selecciona una solución</option>
							<option>Aplicación web</option>
							<option>Aplicación móvil</option>
							<option>Escalamiento digital</option>
							<option>Inteligencia artificial</option>
							<option>Otro proyecto</option>
						</select>
					</label>
					<label>Cuéntanos un poco más *
						<textarea name="message" rows="4" placeholder="¿Qué reto quieres resolver?" required></textarea>
					</label>
					<button class="button form-submit" type="submit" disabled={!formspreeEndpoint}>
						Enviar consulta <span aria-hidden="true">↗</span>
					</button>
					<p class="form-note" role="status" aria-live="polite">
						{formspreeEndpoint
							? 'Tus datos se usarán únicamente para responder a tu consulta.'
							: 'El envío estará disponible al configurar el endpoint de Formspree.'}
					</p>
				</form>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="section-wrap footer-inner">
			<a class="brand" href="#inicio" aria-label="IS&BI Solutions, volver al inicio">
				<span class="brand-mark" aria-hidden="true">IS</span>
				<span class="brand-name">IS&BI <span>SOLUTIONS</span></span>
			</a>
			<p>Tecnología con visión de negocio.</p>
			<a href="#inicio">Volver arriba ↑</a>
			<span>© {new Date().getFullYear()} IS&BI Solutions</span>
		</div>
	</footer>
</Layout>

<script>
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const emailLocal = contactForm?.querySelector<HTMLInputElement>('[name="email-local"]');
	const emailDomain = contactForm?.querySelector<HTMLSelectElement>('[name="email-domain"]');
	const completeEmail = contactForm?.querySelector<HTMLInputElement>('[data-complete-email]');
	const searchInput = document.querySelector<HTMLInputElement>('[data-solution-search]');
	const solutionCards = Array.from(document.querySelectorAll<HTMLElement>('[data-solution-card]'));
	const categoryFilters = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
	const solutionCount = document.querySelector<HTMLElement>('[data-solution-count]');
	const solutionLabel = document.querySelector<HTMLElement>('[data-solution-label]');
	const solutionDescriptor = document.querySelector<HTMLElement>('[data-solution-descriptor]');
	const emptyState = document.querySelector<HTMLElement>('[data-solution-empty]');
	let activeCategory = 'all';

	const filterSolutions = () => {
		const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
		let visibleCount = 0;

		solutionCards.forEach((card) => {
			const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
			const matchesQuery = card.dataset.search?.toLocaleLowerCase().includes(query) ?? false;
			const isVisible = matchesCategory && matchesQuery;
			card.hidden = !isVisible;
			visibleCount += Number(isVisible);
		});

		if (solutionCount) solutionCount.textContent = String(visibleCount);
		if (solutionLabel) solutionLabel.textContent = visibleCount === 1 ? 'proyecto' : 'proyectos';
		if (solutionDescriptor) solutionDescriptor.textContent = visibleCount === 1 ? 'público' : 'públicos';
		if (emptyState) emptyState.hidden = visibleCount > 0;
	};

	searchInput?.addEventListener('input', filterSolutions);
	categoryFilters.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.categoryFilter ?? 'all';
			categoryFilters.forEach((filter) => {
				const isActive = filter === button;
				filter.classList.toggle('is-active', isActive);
				filter.setAttribute('aria-pressed', String(isActive));
			});
			filterSolutions();
		});
	});

	contactForm?.addEventListener('submit', (event) => {
		if (
			contactForm.dataset.endpointReady !== 'true' ||
			!emailLocal ||
			!emailDomain ||
			!completeEmail
		) {
			event.preventDefault();
			return;
		}

		completeEmail.value = `${emailLocal.value.trim()}@${emailDomain.value}`;
	});

	const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]');
	if ('IntersectionObserver' in window) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.14, rootMargin: '0px 0px -36px 0px' },
		);

		revealElements.forEach((element) => {
			element.classList.add('reveal-pending');
			revealObserver.observe(element);
		});
	} else {
		revealElements.forEach((element) => element.classList.add('is-visible'));
	}
</script>
