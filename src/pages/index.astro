		<section class="presence-section" id="presencia">
			<div class="section-wrap">
				<div class="section-intro presence-intro" data-reveal>
					<div>
						<p class="eyebrow">CERCA DE TUS PROYECTOS</p>
						<h2>Presencia y clientes<br /><span>en:</span></h2>
					</div>
					<p>Selecciona un pin para explorar nuestras ubicaciones en México y Estados Unidos.</p>
				</div>
				<div class="presence-map" data-presence-map data-reveal>
					<div class="map-canvas">
						<iframe
							class="map-google-frame"
							src="https://www.google.com/maps/embed?origin=mfe&pb=!1m10!1m8!1m3!1d14811149.542883562!2d-101.5!3d25!3m2!1i1024!2i768!4f13.1!6i5"
							title="Mapa de Google Maps: México y Texas"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-pins" role="group" aria-label="Selecciona una ubicación">
							{locations.map((location, index) => (
								<button
									class:list={['map-pin', index === 0 && 'is-active']}
									type="button"
									data-map-pin
									data-location-name={location.name}
									data-location-detail={location.detail}
									data-location-lat={location.lat}
									data-location-lng={location.lng}
									aria-label={`${location.name}, ${location.detail}`}
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									<span class="map-pin-dot" aria-hidden="true"></span>
