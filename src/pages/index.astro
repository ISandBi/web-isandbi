---
import Layout from '../layouts/Layout.astro';

const contactEmail = 'mauricio.garro@ilb.edu.mx';
const photos = [
	{ number: '01', title: 'Personas, primero', path: '/images/equipo-consultoria.jpg', className: 'photo-main' },
	{ number: '02', title: 'Desarrollo web', path: '/images/desarrollo-web.jpg', className: 'photo-web' },
	{ number: '03', title: 'Soluciones móviles', path: '/images/apps-moviles.jpg', className: 'photo-mobile' },
	{ number: '04', title: 'Juntas presenciales', path: '/images/reunion-presencial.jpg', className: 'photo-meeting' },
];
---

<Layout title="ISANDBI Solutions | Tecnología con visión de negocio">
	<header class="site-header">
		<div class="header-inner">
			<a class="brand" href="#inicio" aria-label="ISANDBI Solutions, inicio">
				<span class="brand-mark" aria-hidden="true">i</span>
				<span class="brand-name">ISANDBI<span> SOLUTIONS</span></span>
			</a>
			<nav class="main-nav" aria-label="Navegación principal">
				<a href="#servicios">Servicios</a>
				<a href="#nosotros">Cómo trabajamos</a>
				<a href="#contacto">Contacto</a>
			</nav>
			<div class="header-actions">
				<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema">
					<svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
					</svg>
					<span data-theme-label>Tema</span>
				</button>
				<a class="button button-small header-cta" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</header>

	<main>
		<section class="hero section-wrap" id="inicio">
			<div class="hero-copy">
				<p class="eyebrow"><span class="status-dot"></span> CONSULTORÍA DIGITAL · MÉXICO</p>
				<h1>La tecnología correcta <span>cambia lo que es posible.</span></h1>
				<p class="hero-description">
					Diseñamos y desarrollamos soluciones digitales a la medida para que tu negocio avance
					con claridad, agilidad y un equipo que sí se involucra.
				</p>
				<div class="hero-actions">
					<a class="button" href="#contacto">Cuéntanos tu proyecto <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="#servicios">Conoce lo que hacemos <span aria-hidden="true">↓</span></a>
				</div>
				<div class="hero-note">
					<span class="note-icon" aria-hidden="true">✳</span>
					<p><strong>Trato personalizado.</strong> Ideas claras, comunicación directa y juntas presenciales.</p>
				</div>
			</div>

			<div class="photo-mosaic" aria-label="Espacios reservados para fotografías del equipo y los proyectos">
				{photos.map((photo) => (
					<div class:list={['photo-slot', photo.className]} data-photo-slot>
						<img src={photo.path} alt={photo.title} loading="lazy" />
						<div class="photo-placeholder">
							<span class="photo-number">{photo.number} / FOTO</span>
							<svg viewBox="0 0 48 48" aria-hidden="true">
								<rect x="7" y="10" width="34" height="28" rx="4"></rect>
								<circle cx="18" cy="20" r="3"></circle>
								<path d="m9 33 10-9 7 6 5-4 8 7"></path>
							</svg>
							<strong>{photo.title}</strong>
							<code>{photo.path}</code>
						</div>
					</div>
				))}
				<div class="mosaic-caption"><span class="status-dot"></span> Ideas que toman forma en equipo</div>
			</div>
		</section>

		<section class="trust-strip" aria-label="Nuestro enfoque">
			<div class="section-wrap trust-inner">
				<p>TECNOLOGÍA A TU FAVOR</p>
				<span>Desarrollo a la medida</span>
				<span>Inteligencia artificial</span>
				<span>Escalamiento sostenible</span>
				<span>Colaboración cercana</span>
			</div>
		</section>

		<section class="services section-wrap section-spacing" id="servicios">
			<div class="section-heading">
				<div>
					<p class="eyebrow">LO QUE HACEMOS</p>
					<h2>Soluciones pensadas <span>para avanzar.</span></h2>
				</div>
				<p class="section-intro">
					Desde la primera idea hasta la siguiente etapa de crecimiento, conectamos tecnología
					con necesidades reales de negocio.
				</p>
			</div>

			<div class="service-grid">
				<article class="service-card">
					<div class="service-topline"><span class="service-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M8 13h3m-3 3h7"></path></svg>
					</span><span class="service-index">01</span></div>
					<h3>Aplicaciones web</h3>
					<p>Plataformas y herramientas web ágiles, seguras y hechas a la medida con tecnologías modernas.</p>
					<a href="#contacto" aria-label="Consultar sobre aplicaciones web">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
				</article>
				<article class="service-card">
					<div class="service-topline"><span class="service-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><path d="M10 5h4m-3 13h2"></path></svg>
					</span><span class="service-index">02</span></div>
					<h3>Aplicaciones móviles</h3>
					<p>Experiencias móviles intuitivas que conectan tus servicios con las personas, dondequiera que estén.</p>
					<a href="#contacto" aria-label="Consultar sobre aplicaciones móviles">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
				</article>
				<article class="service-card">
					<div class="service-topline"><span class="service-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M3 17 9 11l4 4 8-9"></path><path d="M15 6h6v6"></path><path d="M4 21h16"></path></svg>
					</span><span class="service-index">03</span></div>
					<h3>Escalamiento digital</h3>
					<p>Mejoramos y preparamos tus sistemas para acompañar nuevas oportunidades y más usuarios.</p>
					<a href="#contacto" aria-label="Consultar sobre escalamiento digital">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
				</article>
				<article class="service-card">
					<div class="service-topline"><span class="service-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42m-9.88 9.88-1.42 1.42"></path><circle cx="12" cy="12" r="4"></circle></svg>
					</span><span class="service-index">04</span></div>
					<h3>Inteligencia artificial</h3>
					<p>Aplicamos IA para agilizar procesos, reducir tareas repetitivas y darle más tiempo a lo importante.</p>
					<a href="#contacto" aria-label="Consultar sobre inteligencia artificial">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
				</article>
			</div>
		</section>

		<section class="approach" id="nosotros">
			<div class="section-wrap approach-inner">
				<div class="approach-copy">
					<p class="eyebrow">UNA COLABORACIÓN DIFERENTE</p>
					<h2>No eres un ticket.<br /><span>Eres nuestro socio.</span></h2>
					<p class="approach-description">
						Creemos que los mejores resultados empiezan escuchando. Trabajamos contigo de forma
						cercana, explicamos cada decisión sin rodeos y nos reunimos presencialmente cuando
						el proyecto lo necesita.
					</p>
					<a class="button button-outline" href="#contacto">Conoce al equipo <span aria-hidden="true">↗</span></a>
				</div>
				<div class="approach-points">
					<div class="approach-point">
						<span class="point-number">01</span>
						<div><h3>Escuchamos antes de proponer</h3><p>Entendemos tus metas, tus procesos y el reto detrás de cada idea.</p></div>
					</div>
					<div class="approach-point">
						<span class="point-number">02</span>
						<div><h3>Hablamos en claro</h3><p>Avances visibles, acuerdos transparentes y comunicación directa contigo.</p></div>
					</div>
					<div class="approach-point">
						<span class="point-number">03</span>
						<div><h3>Nos sentamos contigo</h3><p>Juntas presenciales y sesiones de trabajo personalizadas, según lo que necesites.</p></div>
					</div>
				</div>
			</div>
		</section>

		<section class="contact section-wrap section-spacing" id="contacto">
			<div class="contact-copy">
				<p class="eyebrow">EL PRIMER PASO</p>
				<h2>¿Qué te gustaría <span>hacer posible?</span></h2>
				<p>Cuéntanos un poco de tu proyecto. Nos pondremos en contacto para conocerte y explorar juntos el siguiente paso.</p>
				<a class="contact-email" href={`mailto:${contactEmail}`}>
					<span class="email-icon" aria-hidden="true">↗</span>
					<span><small>También puedes escribirnos</small><strong>{contactEmail}</strong></span>
				</a>
				<p class="contact-personal"><span class="status-dot"></span> Atención directa y personalizada</p>
			</div>

			<form class="contact-form" action={`https://formsubmit.co/${contactEmail}`} method="POST">
				<input type="hidden" name="_subject" value="Nuevo mensaje desde ISANDBI Solutions" />
				<input type="hidden" name="_template" value="table" />
				<div class="form-heading"><h3>Cuéntanos tu idea</h3><span>* Campos obligatorios</span></div>
				<div class="form-row">
					<label>Nombre completo *
						<input type="text" name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required />
					</label>
					<label>Correo electrónico *
						<input type="email" name="email" autocomplete="email" placeholder="tu@empresa.com" required />
					</label>
				</div>
				<label>¿En qué podemos ayudarte? *
					<select name="service" required>
						<option value="" disabled selected>Selecciona un servicio</option>
						<option>Aplicación web</option>
						<option>Aplicación móvil</option>
						<option>Escalamiento digital</option>
						<option>Inteligencia artificial</option>
						<option>Otro proyecto</option>
					</select>
				</label>
				<label>Cuéntanos un poco más *
					<textarea name="message" rows="4" placeholder="¿Qué reto quieres resolver?" required></textarea>
				</label>
				<button class="button form-submit" type="submit">Enviar mensaje <span aria-hidden="true">↗</span></button>
				<p class="form-note">Al enviar este formulario, tu mensaje y datos de contacto serán procesados para responder a tu consulta.</p>
			</form>
		</section>
	</main>

	<footer class="site-footer">
		<div class="section-wrap footer-inner">
			<a class="brand footer-brand" href="#inicio" aria-label="ISANDBI Solutions, volver al inicio">
				<span class="brand-mark" aria-hidden="true">i</span>
				<span class="brand-name">ISANDBI<span> SOLUTIONS</span></span>
			</a>
			<p>Tecnología con visión de negocio.</p>
			<a href="#inicio">Volver arriba ↑</a>
			<small>© {new Date().getFullYear()} ISANDBI Solutions</small>
		</div>
	</footer>
</Layout>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const themeLabel = themeToggle?.querySelector<HTMLElement>('[data-theme-label]');

	const updateThemeControl = () => {
		const isDark = document.documentElement.dataset.theme === 'dark';
		themeToggle?.setAttribute('aria-label', `Cambiar a modo ${isDark ? 'claro' : 'oscuro'}`);
		themeToggle?.setAttribute('aria-pressed', String(isDark));
		if (themeLabel) themeLabel.textContent = isDark ? 'Modo claro' : 'Modo oscuro';
	};

	updateThemeControl();
	themeToggle?.addEventListener('click', () => {
		const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = nextTheme;
		localStorage.setItem('isandbi-theme', nextTheme);
		updateThemeControl();
	});

	document.querySelectorAll<HTMLImageElement>('[data-photo-slot] img').forEach((image) => {
		const slot = image.closest<HTMLElement>('[data-photo-slot]');
		const showPhoto = () => slot?.classList.add('has-photo');
		image.addEventListener('load', showPhoto);
		image.addEventListener('error', () => image.remove());
		if (image.complete && image.naturalWidth > 0) showPhoto();
	});
</script>

<style>
	.section-wrap { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }
	.site-header { position: sticky; z-index: 10; top: 0; border-bottom: 1px solid var(--line); background: var(--header-bg); backdrop-filter: blur(18px); }
	.header-inner { width: min(1280px, calc(100% - 64px)); min-height: 78px; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; white-space: nowrap; }
	.brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px 10px 10px 3px; background: var(--accent); color: #fff; font-size: 24px; font-weight: 750; line-height: 1; }
	.brand-name { font-size: 13px; font-weight: 750; letter-spacing: .07em; }
	.brand-name span { color: var(--muted); font-weight: 500; }
	.main-nav, .header-actions { display: flex; align-items: center; }
	.main-nav { gap: 32px; }
	.main-nav a, .text-link { color: var(--muted); font-size: 13px; text-decoration: none; transition: color .2s ease; }
	.main-nav a:hover, .text-link:hover { color: var(--accent-light); }
	.header-actions { gap: 16px; }
	.theme-toggle { display: inline-flex; align-items: center; gap: 8px; padding: 9px 10px; border: 0; background: transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: 12px; }
	.theme-icon { width: 17px; height: 17px; fill: none; stroke: var(--accent-light); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
	.button { display: inline-flex; align-items: center; justify-content: center; gap: 17px; min-height: 48px; padding: 0 20px; border: 1px solid var(--accent); border-radius: 5px; background: var(--accent); color: #fff; font-size: 13px; font-weight: 650; text-decoration: none; transition: transform .2s ease, background .2s ease; }
	.button:hover { transform: translateY(-2px); background: var(--accent-strong); }
	.button-small { min-height: 38px; padding-inline: 15px; font-size: 12px; }
	.hero { display: grid; grid-template-columns: 1fr 1.02fr; align-items: center; gap: 62px; padding-block: 82px 92px; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--accent-light); font-size: 10px; font-weight: 750; letter-spacing: .14em; }
	.status-dot { flex: 0 0 7px; width: 7px; height: 7px; border-radius: 50%; background: #62c6ff; box-shadow: 0 0 12px #62c6ff66; }
	h1, h2, h3, p { margin-top: 0; }
	h1 { max-width: 580px; margin-bottom: 22px; color: var(--heading); font-size: clamp(42px, 5vw, 66px); font-weight: 600; letter-spacing: -.055em; line-height: 1.07; }
	h1 span, h2 span { color: var(--accent-light); }
	.hero-description, .section-intro, .approach-description, .contact-copy > p:not(.eyebrow):not(.contact-personal) { color: var(--muted); font-size: 15px; line-height: 1.8; }
	.hero-description { max-width: 465px; margin-bottom: 28px; }
	.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
	.text-link { font-size: 12px; }
	.text-link span { padding-left: 5px; color: var(--accent-light); }
	.hero-note { display: flex; align-items: center; gap: 12px; max-width: 380px; margin-top: 42px; padding-top: 18px; border-top: 1px solid var(--line); }
	.note-icon { color: var(--accent-light); font-size: 22px; }
	.hero-note p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
	.hero-note strong { color: var(--text); }
	.photo-mosaic { position: relative; display: grid; grid-template-columns: 1.16fr .84fr; grid-template-rows: 172px 172px; gap: 12px; padding-bottom: 28px; }
	.photo-slot { position: relative; min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: linear-gradient(145deg, var(--photo-a), var(--photo-b)); }
	.photo-slot::after { position: absolute; inset: 0; background: linear-gradient(155deg, transparent 30%, #061b38aa); content: ''; pointer-events: none; }
	.photo-slot img { position: absolute; z-index: 1; width: 100%; height: 100%; object-fit: cover; }
	.photo-placeholder { position: absolute; z-index: 2; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; padding: 14px; color: #ffffffd9; text-align: center; }
	.photo-placeholder svg { width: 31px; height: 31px; fill: none; stroke: #87c8ff; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
	.photo-placeholder strong { font-size: 12px; font-weight: 600; }
	.photo-placeholder code { color: #ffffffa8; font: 10px/1.3 ui-monospace, monospace; }
	.photo-number { color: #9bd5ff; font-size: 9px; font-weight: 700; letter-spacing: .14em; }
	.photo-slot.has-photo .photo-placeholder { align-items: flex-start; justify-content: flex-end; background: linear-gradient(0deg, #061b38bd, transparent 65%); text-align: left; }
	.photo-slot.has-photo .photo-placeholder svg, .photo-slot.has-photo .photo-placeholder code { display: none; }
	.photo-main { grid-row: span 2; }
	.photo-web { background: linear-gradient(145deg, #124896, #10274d); }
	.photo-mobile { background: linear-gradient(145deg, #164679, #161f43); }
	.photo-meeting { background: linear-gradient(145deg, #1d5282, #172b50); }
	.mosaic-caption { position: absolute; right: 4px; bottom: 0; display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 10px; }
	.trust-strip { border-block: 1px solid var(--line); background: var(--surface-subtle); }
	.trust-inner { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 20px; }
	.trust-inner p { margin: 0; color: var(--accent-light); font-size: 9px; font-weight: 750; letter-spacing: .13em; }
	.trust-inner span { color: var(--muted); font-size: 11px; }
	.section-spacing { padding-block: 100px; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 40px; }
	.section-heading .eyebrow { margin-bottom: 14px; }
	h2 { margin-bottom: 0; color: var(--heading); font-size: clamp(32px, 4vw, 45px); font-weight: 580; letter-spacing: -.045em; line-height: 1.15; }
	.section-intro { max-width: 390px; margin-bottom: 4px; font-size: 13px; }
	.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
	.service-card { display: flex; min-height: 255px; flex-direction: column; padding: 22px 19px 18px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); transition: border-color .2s ease, transform .2s ease; }
	.service-card:hover { transform: translateY(-4px); border-color: var(--accent-light); }
	.service-topline { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
	.service-icon { display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid var(--line); border-radius: 7px; background: var(--icon-bg); }
	.service-icon svg { width: 21px; height: 21px; fill: none; stroke: var(--accent-light); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
	.service-index { color: var(--muted); font-size: 10px; }
	.service-card h3 { margin-bottom: 10px; color: var(--heading); font-size: 16px; font-weight: 600; }
	.service-card > p { margin-bottom: 19px; color: var(--muted); font-size: 11px; line-height: 1.75; }
	.service-card > a { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; color: var(--accent-light); font-size: 10px; text-decoration: none; }
	.approach { border-block: 1px solid var(--line); background: var(--surface-subtle); }
	.approach-inner { display: grid; grid-template-columns: .92fr 1.08fr; align-items: center; gap: 100px; padding-block: 92px; }
	.approach-copy .eyebrow { margin-bottom: 16px; }
	.approach-copy h2 { margin-bottom: 20px; }
	.approach-description { max-width: 440px; margin-bottom: 25px; font-size: 13px; }
	.button-outline { border-color: var(--line-strong); background: transparent; color: var(--text); }
	.button-outline:hover { border-color: var(--accent-light); background: var(--surface); }
	.approach-points { border-top: 1px solid var(--line); }
	.approach-point { display: grid; grid-template-columns: 48px 1fr; gap: 13px; padding: 22px 0; border-bottom: 1px solid var(--line); }
	.point-number { padding-top: 3px; color: var(--accent-light); font-size: 11px; font-weight: 700; }
	.approach-point h3 { margin-bottom: 6px; color: var(--heading); font-size: 14px; font-weight: 600; }
	.approach-point p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.7; }
	.contact { display: grid; grid-template-columns: .9fr 1.1fr; gap: 90px; align-items: start; }
	.contact-copy { padding-top: 12px; }
	.contact-copy .eyebrow { margin-bottom: 16px; }
	.contact-copy h2 { margin-bottom: 17px; }
	.contact-copy > p:not(.eyebrow):not(.contact-personal) { max-width: 420px; margin-bottom: 27px; font-size: 13px; }
	.contact-email { display: inline-flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; }
	.email-icon { display: grid; width: 39px; height: 39px; place-items: center; border: 1px solid var(--line); border-radius: 7px; color: var(--accent-light); }
	.contact-email span:last-child { display: grid; gap: 4px; }
	.contact-email small { color: var(--muted); font-size: 10px; }
	.contact-email strong { font-size: 12px; font-weight: 550; }
	.contact-personal { display: flex; align-items: center; gap: 9px; margin-top: 29px; color: var(--muted); font-size: 10px; }
	.contact-form { display: grid; gap: 18px; padding: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
	.form-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 2px; }
