						<div class="map-scale" aria-hidden="true"><span></span><i>MAPA DE UBICACIONES</i></div>
					</div>
					<div class="map-location-card" data-map-location-card aria-live="polite">
						<iframe
							class="map-location-image"
							src={`https://www.google.com/maps/embed?origin=mfe&pb=!1m2!2m1!1s${locations[0].lat}%2C${locations[0].lng}`}
							title={`Google Maps: ${locations[0].name}, ${locations[0].detail}`}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
							data-map-location-image
						></iframe>
						<div class="map-location-copy">
							<p data-map-location-region>{locations[0].detail}</p>
							<h3 data-map-location-name>{locations[0].name}</h3>
							<a
								class="map-open-link"
								href={`https://www.google.com/maps/search/?api=1&query=${locations[0].lat}%2C${locations[0].lng}`}
								target="_blank"
								rel="noopener noreferrer"
								data-map-open-link
							>
								Abrir en Google Maps <span aria-hidden="true">↗</span>
