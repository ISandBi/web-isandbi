		</>
	)}
	{icon === 'postgresql' && (
		<>
			<path d="M11 33c-3-3-4-8-3-14 1-7 6-12 13-12 7 0 12 4 12 11 0 5-2 9-6 10l-2 5h-5l1-8c-2 2-4 3-7 2l-3 6Z" />
			<path d="M16 12c2-2 6-2 8 0m3 1c2 2 2 5 1 7m-13-3h.1m8-.2h.1M9 22l-4 2m25 1 4 2" />
		</>
	)}
	{icon === 'mysql' && (
		<>
			<path d="M6 29c4-7 8-11 13-11 4 0 6 3 9 2 2-.7 3-3 5-5m-24 17c4-2 6-6 9-8 3-2 6 0 8-1m-4-8 2-7m0 0 5 4m-5-4-5 4" />
