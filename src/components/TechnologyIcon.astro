		</>
	)}
	{icon === 'vue' && (
		<>
			<path d="m4 8 8 0 8 14 8-14h8L20 34 4 8Z" />
			<path d="m12 8 8 14 8-14" />
		</>
	)}
	{icon === 'iot' && (
		<>
			<circle cx="20" cy="20" r="5" />
			<circle cx="7" cy="8" r="3" />
