			<path d="M14 13h12l-.5 4H15m-.5 4h10.7l-.8 8-4.3 1.3-4.3-1.3-.3-3" />
		</>
	)}
	{icon === 'javascript' && (
		<>
			<rect x="4" y="4" width="32" height="32" rx="3" />
			<path d="M22 28c.7 1.2 1.6 1.8 3 1.8s2.2-.6 2.2-1.6c0-1.1-.8-1.5-2.4-2.2-2.2-.9-3.6-2-3.6-4.4 0-2.2 1.7-3.9 4.3-3.9 1.9 0 3.3.7 4.3 2.4M17 18v9c0 2.8-1.5 4.1-4 4.1-1.8 0-3.1-.9-3.8-2.4" />
		</>
	)}
	{icon === 'node' && (
		<>
			<path d="m20 3 15 8.5v17L20 37 5 28.5v-17L20 3Z" />
			<path d="m14 16 6-3.5 6 3.5v8l-6 3.5-6-3.5v-8Zm6-3.5V10m6 6 4-2m-10 14v4m-6-12-4-2" />
			<circle cx="20" cy="10" r="1.5" />
			<circle cx="30" cy="14" r="1.5" />
			<circle cx="10" cy="14" r="1.5" />
			<circle cx="20" cy="32" r="1.5" />
		</>
	)}
	{icon === 'sqlite' && (
		<>
			<ellipse cx="20" cy="9" rx="14" ry="5" />
