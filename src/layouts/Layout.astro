---
interface Props {
	title?: string;
}

const { title = 'ISANDBI Solutions | Consultoría digital' } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Consultoría digital personalizada: aplicaciones web y móviles, escalamiento e inteligencia artificial para hacer avanzar tu negocio."
		/>
		<title>{title}</title>
		<script is:inline>
			const savedTheme = localStorage.getItem('isandbi-theme');
			document.documentElement.dataset.theme =
				savedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root,
	html[data-theme='dark'] {
		color-scheme: dark;
		--bg: #092b69;
		--surface: #0c3478;
		--surface-subtle: #08265c;
		--header-bg: rgb(7 34 80 / 92%);
		--text: #e7f2ff;
		--heading: #fff;
		--muted: #b2c8e5;
		--line: rgb(188 218 255 / 14%);
		--line-strong: rgb(188 218 255 / 32%);
		--accent: #2863dc;
		--accent-strong: #3475f5;
		--accent-light: #82ceff;
		--icon-bg: rgb(59 137 231 / 11%);
		--input-bg: #082b67;
		--focus-ring: rgb(130 206 255 / 18%);
		--photo-a: #124896;
		--photo-b: #10274d;
	}

	html[data-theme='light'] {
		color-scheme: light;
		--bg: #f4f7fc;
		--surface: #fff;
		--surface-subtle: #edf3fc;
		--header-bg: rgb(248 250 255 / 94%);
		--text: #27374f;
		--heading: #102348;
		--muted: #607087;
		--line: rgb(28 59 103 / 13%);
		--line-strong: rgb(28 59 103 / 30%);
		--accent: #245cdb;
		--accent-strong: #1747b3;
		--accent-light: #176fc4;
		--icon-bg: #edf5ff;
		--input-bg: #f8faff;
		--focus-ring: rgb(36 92 219 / 14%);
		--photo-a: #dceaff;
		--photo-b: #b9d1f4;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		width: 100%;
		min-height: 100%;
		margin: 0;
		scroll-behavior: smooth;
	}

	html {
		scroll-padding-top: 90px;
		background: var(--bg);
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	::selection {
		background: var(--accent);
		color: #fff;
	}
</style>
