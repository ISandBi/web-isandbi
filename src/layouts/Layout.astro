---
interface Props {
	title?: string;
}

const { title = 'IS&BI Solutions | Innovation Software' } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light" data-theme-palette="pink">
	<head>
		<script is:inline>
			try {
				const palettes = ['pink', 'space', 'green', 'dark'];
				const savedPalette = localStorage.getItem('isandbi-theme-palette');
				const legacyTheme = localStorage.getItem('isandbi-theme');
				const palette = palettes.includes(savedPalette ?? '')
					? savedPalette
					: legacyTheme === 'dark'
						? 'dark'
						: legacyTheme === 'light'
							? 'pink'
							: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'pink';
				document.documentElement.dataset.themePalette = palette;
				document.documentElement.dataset.theme = palette === 'space' || palette === 'dark' ? 'dark' : 'light';
			} catch {
				const palette = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'pink';
				document.documentElement.dataset.themePalette = palette;
				document.documentElement.dataset.theme = palette === 'dark' ? 'dark' : 'light';
			}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Diseñamos software y experiencias digitales para resolver retos reales y ayudar a tu negocio a crecer."
		/>
		<meta name="theme-color" content="#0b1722" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
